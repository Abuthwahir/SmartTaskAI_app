# Copy this file to local.properties and fill in your values
# DO NOT commit local.properties to git

# Android SDK location (required)
sdk.dir=/path/to/your/Android/sdk
# macOS example:   sdk.dir=/Users/yourname/Library/Android/sdk
# Linux example:   sdk.dir=/home/yourname/Android/sdk
# Windows example: sdk.dir=C\:\\Users\\yourname\\AppData\\Local\\Android\\sdk

# Gemini API key (optional - can also be set in app/build.gradle)
GEMINI_API_KEY=your_gemini_api_key_here
