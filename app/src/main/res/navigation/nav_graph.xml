<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/tasksFragment">

    <!-- TASKS -->
    <fragment
        android:id="@+id/tasksFragment"
        android:name="com.smarttask.ui.tasks.TasksFragment"
        android:label="Tasks"
        tools:layout="@layout/fragment_tasks">

        <action
            android:id="@+id/action_tasksFragment_to_addEditTaskFragment"
            app:destination="@id/addEditTaskFragment"
            app:enterAnim="@anim/slide_in_up"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/slide_out_down" />
    </fragment>

    <!-- CALENDAR -->
    <fragment
        android:id="@+id/calendarFragment"
        android:name="com.smarttask.ui.calendar.CalendarFragment"
        android:label="Calendar"
        tools:layout="@layout/fragment_calendar">

        <action
            android:id="@+id/action_calendarFragment_to_addEditTaskFragment"
            app:destination="@id/addEditTaskFragment"
            app:enterAnim="@anim/slide_in_up"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/slide_out_down" />
    </fragment>

    <!-- AI ASSISTANT -->
    <fragment
        android:id="@+id/assistantFragment"
        android:name="com.smarttask.ui.assistant.AssistantFragment"
        android:label="AI Assistant"
        tools:layout="@layout/fragment_assistant" />

    <!-- SETTINGS -->
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.smarttask.ui.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

    <!-- ADD / EDIT TASK -->
    <fragment
        android:id="@+id/addEditTaskFragment"
        android:name="com.smarttask.ui.add_edit.AddEditTaskFragment"
        android:label="Add / Edit Task"
        tools:layout="@layout/fragment_add_edit_task">

        <!-- FIXED: long should NOT use L -->
        <argument
            android:name="taskId"
            app:argType="long"
            android:defaultValue="0L" />

        <!-- FIXED: avoid empty string -->
        <argument
            android:name="date"
            app:argType="string"
            android:defaultValue="none" />

    </fragment>

</navigation>